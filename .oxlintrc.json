{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Las cuatro siguientes se apagan a propósito: en este proyecto solo
    // disparan sobre patrones deliberados y seguros (cargar datos del
    // backend en un efecto, un ref siempre actualizado tipo `ref.current =
    // valor` en cada render, una variable local reseteada en cada render
    // para calcular un índice dentro de un .map(), o una función llamada
    // solo dentro de un manejador de evento que el análisis estático de la
    // regla confunde con el cuerpo del render) — no detectan bugs reales
    // aquí, solo generan ruido. Si algún día se quiere revisar de nuevo,
    // basta con borrar estas cuatro líneas.
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/immutability": "off",
    "react/refs": "off"
  }
}
