# Copy this file to ".env" and fill in your Supabase project credentials.
# Find them in Supabase: Project Settings > API.
#
# If these are left empty, the site automatically runs in local "demo mode":
# all data is stored in the browser's localStorage and the admin panel uses
# a demo login instead of Supabase Auth. See README.md for details.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Si se deja vacío, no se carga ningún script de analítica. Solo mide el
# sitio público — nunca se activa dentro de /admin.
VITE_GA_MEASUREMENT_ID=

# Opcional: resumen de Analytics en el Dashboard del admin (ver README).
# Estas cuatro SOLO se configuran en Vercel (Settings > Environment
# Variables) — nunca deben llevar el prefijo VITE_ ni vivir en este
# archivo con un valor real, porque eso las mandaría al navegador.
# GA_OAUTH_CLIENT_ID=
# GA_OAUTH_CLIENT_SECRET=
# GA_OAUTH_REFRESH_TOKEN=
# GA_PROPERTY_ID=

# Opcional: "Mercado en internet" en /admin/valuacion (ver README). Igual que
# las de Analytics, SOLO se configuran en Vercel, sin prefijo VITE_.
# ANTHROPIC_API_KEY=          # llave de console.anthropic.com
# MARKET_MODEL=               # por defecto claude-opus-5-5 (claude-sonnet-5-5 cuesta ~la mitad)
# MARKET_DAILY_LIMIT=         # consultas nuevas por día (por defecto 20)

# Opcional: "Calcar un croquis (IA)" en /admin/construccion (ver README).
# Reutiliza la misma ANTHROPIC_API_KEY de arriba — no hace falta otra llave.
# SKETCH_MODEL=               # por defecto claude-opus-5-5 (claude-sonnet-5-5 cuesta ~la mitad)
# SKETCH_DAILY_LIMIT=         # consultas nuevas por día (por defecto 20)

# Opcional: chatbot público del sitio (reemplaza al botón flotante de
# WhatsApp — ver README). Reutiliza la misma ANTHROPIC_API_KEY de arriba.
# Además de esa llave, necesita SUPABASE_SERVICE_ROLE_KEY (más abajo) para
# guardar los leads que capture y limitar el abuso.
# CHAT_MODEL=                   # por defecto claude-haiku-5-5 (el más barato; de sobra para FAQ y captura de contacto)
# CHAT_SESSION_HOURLY_LIMIT=    # mensajes por conversación por hora (por defecto 30)
# CHAT_DAILY_LIMIT=             # mensajes nuevos por día, en todo el sitio (por defecto 500)

# Requerido para el Portal de documentos del cliente (/documentos/<token>,
# ver README) y para el chatbot público (arriba). Solo se configura en
# Vercel, NUNCA en este archivo ni con el prefijo VITE_: api/portal-upload.js
# la usa para validar el enlace, subir el archivo a Storage e insertar la
# fila, y api/chat.js para guardar leads y limitar el abuso — son las únicas
# piezas del sitio (fuera de las Edge Functions de Supabase) que la
# necesitan. Está en Supabase: Project Settings > API > Project API keys >
# service_role.
# SUPABASE_SERVICE_ROLE_KEY=

# Opcional: tasa de referencia del mercado (TIIE 28 días) en el comparador
# de créditos público /comparar-creditos (ver README). Token gratuito de
# Banxico (SIE API, https://www.banxico.org.mx/SieAPIRest/service/v1/) — se
# registra desde esa misma página (busca el enlace de registro/token de
# consulta; no hay una URL fija de registro confirmada para documentar aquí).
# Solo se configura en Vercel, NUNCA en este archivo ni con el prefijo VITE_:
# no es tan sensible como ANTHROPIC_API_KEY, pero tampoco hace falta
# exponerla en el navegador. Si se deja vacío, el comparador funciona igual,
# solo sin la nota de tasa de referencia.
# BANXICO_TOKEN=

# Opcionales del Portal de documentos del cliente:
# CSF_MAX_AGE_MONTHS=         # alerta si la Constancia Fiscal es más vieja que esto (por defecto 3)
# DOCUMENT_VALIDATION_PROVIDER=  # nombre de un adapter en server/documentProviders/ — vacío = solo validación local (regex + QR), sin red externa

# Opcional: notificaciones push del navegador/SO en el panel admin (ver
# README). La llave PÚBLICA es segura de exponer en el navegador — para eso
# es pública — así que va aquí con prefijo VITE_. La llave PRIVADA y el
# "subject" (un mailto: de contacto) NUNCA van en este archivo: se
# configuran solo como secretos de la Edge Function enviar-push en
# Supabase (Project Settings > Edge Functions > Secrets), igual que
# WHATSAPP_TOKEN o RESEND_API_KEY. Las tres se generan juntas con
# `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=          # solo en Supabase Edge Function secrets
# VAPID_SUBJECT=              # mailto:tu-correo@dominio.com — solo en Supabase Edge Function secrets
